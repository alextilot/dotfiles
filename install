#!/usr/bin/env bash
# Install script for dotfiles using stow
# This script will stow all the configuration directories

set -e  # Exit on any error

# Set default values if environment variables are not set
DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
STOW_FOLDERS="${STOW_FOLDERS:-git,zsh,tmux,bin}"
# Set to 0 to skip package installation and only stow files.
INSTALL_PACKAGES="${INSTALL_PACKAGES:-1}"
# Essential packages for this dotfiles setup.
# tree-sitter-cli: nvim-treesitter shells out to it (and a C compiler) to
# build parsers; without it Neovim errors/crashes opening most filetypes.
ESSENTIAL_PACKAGES=(stow git zsh tmux fzf neovim lazygit tree-sitter-cli)
# Linux-only: macOS already has a C compiler via Xcode CLT (required by
# Homebrew itself), so there's no equivalent brew package to add above.
LINUX_ONLY_PACKAGES=(build-essential)

# Plugin managers .zshrc / .tmux.conf expect on disk. Override the repo (e.g. a
# fork) or install dir via env vars without editing this script.
ANTIDOTE_DIR="${ANTIDOTE_DIR:-${ZDOTDIR:-$HOME}/.antidote}"
ANTIDOTE_REPO="${ANTIDOTE_REPO:-https://github.com/mattmc3/antidote.git}"
TPM_DIR="${TPM_DIR:-$HOME/.tmux/plugins/tpm}"
TPM_REPO="${TPM_REPO:-https://github.com/tmux-plugins/tpm.git}"

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

package_is_installed() {
    local package="$1"
    case "$(uname -s)" in
        Darwin)
            brew list --versions "$package" >/dev/null 2>&1
            ;;
        Linux)
            dpkg -s "$package" >/dev/null 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

clone_if_missing() {
    local dir="$1"
    local repo="$2"
    shift 2
    if [ -d "$dir" ]; then
        echo "✓ $(basename "$dir") already present at $dir"
        return
    fi
    echo "Cloning $repo -> $dir"
    git clone "$@" "$repo" "$dir"
}

install_missing_packages() {
    local missing=("$@")
    if [ "${#missing[@]}" -eq 0 ]; then
        echo "✓ All required packages already installed"
        return
    fi

    echo "Installing missing packages: ${missing[*]}"
    case "$(uname -s)" in
        Darwin)
            if ! command_exists brew; then
                echo "✗ Homebrew not found. Install Homebrew first, then run ./install again."
                exit 1
            fi
            brew install "${missing[@]}"
            ;;
        Linux)
            if ! command_exists apt-get; then
                echo "✗ Unsupported package manager. Please install these manually: ${missing[*]}"
                exit 1
            fi
            sudo apt-get update
            sudo apt-get install -y "${missing[@]}"
            ;;
        *)
            echo "✗ Unsupported OS. Please install these manually: ${missing[*]}"
            exit 1
            ;;
    esac
}

echo "Installing dotfiles from: $DOTFILES"
echo "Stowing folders: $STOW_FOLDERS"

# Change to dotfiles directory
pushd "$DOTFILES" > /dev/null

# Convert comma-separated string to array
IFS=',' read -ra folders <<< "$STOW_FOLDERS"

if [[ "$INSTALL_PACKAGES" == "1" ]]; then
    packages_to_check=("${ESSENTIAL_PACKAGES[@]}")
    [[ "$(uname -s)" == "Linux" ]] && packages_to_check+=("${LINUX_ONLY_PACKAGES[@]}")

    missing_packages=()
    for package in "${packages_to_check[@]}"; do
        if package_is_installed "$package"; then
            echo "✓ $package already installed"
        else
            missing_packages+=("$package")
        fi
    done

    install_missing_packages "${missing_packages[@]}"

    clone_if_missing "$ANTIDOTE_DIR" "$ANTIDOTE_REPO" --depth=1
    clone_if_missing "$TPM_DIR" "$TPM_REPO"
else
    echo "Skipping package installation (INSTALL_PACKAGES=$INSTALL_PACKAGES)"
fi

# Remember which profile (work|personal) this machine is, so future shells
# don't need DOTFILES_PROFILE re-exported. Never overwrite an existing file.
if [[ -n "${DOTFILES_PROFILE:-}" && ! -f "$DOTFILES/zsh/profile.local.zsh" ]]; then
    case "$DOTFILES_PROFILE" in
        work|personal)
            echo "export DOTFILES_PROFILE=$DOTFILES_PROFILE" > "$DOTFILES/zsh/profile.local.zsh"
            echo "✓ Recorded DOTFILES_PROFILE=$DOTFILES_PROFILE in zsh/profile.local.zsh"
            ;;
        *)
            echo "⚠ DOTFILES_PROFILE must be 'work' or 'personal', got '$DOTFILES_PROFILE' - skipping"
            ;;
    esac
fi

# Stow each folder
for folder in "${folders[@]}"; do
    folder="$(trim "$folder")"
    [ -z "$folder" ] && continue
    
    if [ -d "$folder" ]; then
        echo "Stowing $folder..."
        stow -D "$folder" 2>/dev/null || true  # Remove existing symlinks, ignore errors
        stow "$folder"
        echo "✓ $folder stowed successfully"
    else
        echo "⚠ Warning: Directory '$folder' not found, skipping..."
    fi
done

popd > /dev/null

echo "🎉 Dotfiles installation complete!"