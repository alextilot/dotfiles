#!/usr/bin/env bash
# Copy the current git branch name to the clipboard (no trailing newline).
# Cross-platform: macOS (pbcopy), Linux X11 (xclip/xsel), Wayland (wl-copy), WSL (clip.exe).
# Used by both `gbcopy` (zsh alias) and `git bcopy` (gitconfig alias) so the
# clipboard fallback chain lives in exactly one place.
set -euo pipefail

branch=$(git branch --show-current)

if command -v pbcopy >/dev/null 2>&1; then
	printf '%s' "$branch" | pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
	printf '%s' "$branch" | wl-copy
elif command -v xclip >/dev/null 2>&1; then
	printf '%s' "$branch" | xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
	printf '%s' "$branch" | xsel --clipboard --input
elif command -v clip.exe >/dev/null 2>&1; then
	printf '%s' "$branch" | clip.exe
else
	echo "git-branch-copy: no clipboard utility found (install xclip, xsel, or wl-clipboard)" >&2
	exit 1
fi
