[core]
    # editor = nvim
    autocrlf = input
[push]
    default = current
	autoSetupRemote = true
[fetch]
    prune = true
[pull]
    rebase = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[column]
    ui = auto
[diff]
    algorithm = histogram
    colorMoved = default
[alias]
    bclean = "!git fetch --prune && git branch --merged | grep -Ev \"^\\*|^ *(main|master|develop)$|^ *release/\" | xargs -r git branch -d"
    bcopy = "!git-branch-copy"
[user]
	email = alextilot@gmail.com
	name = alextilot
[credential]
	helper = store

# Personal is the default — applies to every repo.
[include]
    path = ~/.gitconfig-personal

# After the personal include so work identity wins.
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-work
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
