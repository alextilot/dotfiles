[core]
    # editor = nvim
    autocrlf = input
    # Shared hooks, tracked in this repo. A repo that sets its own
    # core.hooksPath (husky) still wins.
    hooksPath = ~/.git-templates/hooks
[push]
    default = current
	autoSetupRemote = true
[fetch]
    prune = true
[pull]
    rebase = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[column]
    ui = auto
[diff]
    algorithm = histogram
    colorMoved = default
[alias]
    bclean = "!git fetch --prune && git branch --merged | grep -Ev \"^\\*|^ *(main|master|develop)$|^ *release/\" | xargs -r git branch -d"
    bcopy = "!git-branch-copy"

# Personal is the default — applies to every repo.
[include]
    path = ~/.gitconfig-personal

# After the personal include so work identity wins.
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-work

# Per machine type, so this file stays free of host-specific helpers.
[include]
    path = ~/.gitconfig.os
