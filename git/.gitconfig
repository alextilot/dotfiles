# Personal is the default — applies to every repo.
[include]
    path = ~/.gitconfig-personal

# Work overrides personal inside ~/work/.
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

[core]
    editor = nvim
    autocrlf = input
[push]
    default = current
[fetch]
    prune = true
[pull]
    rebase = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[column]
    ui = auto
[diff]
    algorithm = histogram
    colorMoved = default
[alias]
    bclean = !git fetch --prune && git branch --merged | grep -Ev \"(^\\*|main|master|develop|release/)\" | xargs -r git branch -d
